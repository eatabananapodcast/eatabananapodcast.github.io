---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Merch">
  <section class="merch-page">
    <div class="page-heading">
      <p class="eyebrow">The shop</p>
      <h1>Merchandise</h1>
    </div>
    <div class="merch-placeholder">
      <img class="merch-placeholder-logo" src="/images/eat-a-banana-oval-logo.png" alt="Eat a Banana logo" />
      <p>Merch coming ... eventually!</p>
    </div>
  </section>
</BaseLayout>