---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortedEpisodes } from '../../data/episodes';

const formatDate = (date: string) => new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
}).format(new Date(`${date}T12:00:00`));
---
<BaseLayout title="Episodes">
  <section class="page-heading">
    <p class="eyebrow">The archive</p>
    <h1>Episodes</h1>
  </section>
  <ol class="episode-list">
    {sortedEpisodes.map((episode, index) => (
      <li class="episode-card">
        <img class="episode-thumbnail" src="/images/eat-a-banana-site-cover.jpg" alt="" />
        <span class="episode-number">{String(index + 1).padStart(2, '0')}</span>
        <div>
          <h2><a class="text-link" href={`/episodes/${episode.slug}/`}>{episode.title}</a></h2>
          <p>{episode.description}</p>
          <audio class="audio" controls preload="none" src={episode.audioUrl} aria-label={`Play ${episode.title}`}></audio>
        </div>
        <div class="episode-meta">
          <span>{formatDate(episode.date)}</span>
          {episode.duration && <span>{episode.duration}</span>}
          <a class="button secondary" href={episode.youtubeUrl} target="_blank" rel="noreferrer">
            <svg class="youtube-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8Z" />
              <path class="youtube-icon-triangle" d="m9.6 15.8 6.3-3.8-6.3-3.8v7.6Z" />
            </svg>
            <span>Watch on YouTube</span>
          </a>
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>
